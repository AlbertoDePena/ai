# Copy to .env (gitignored) and adjust:  cp .env.example .env
#
# Read by docker-compose.yml (which loads it automatically) and sourced by
# run-local.sh / migrate.sh for host runs. The endpoint values here are the
# HOST-side ones (localhost / 19092 / ...), used when you run a service on the
# host; compose substitutes its own in-network hostnames and ignores them.
#
# The defaults below work as-is with the stack in docker-compose.yml.

DEV_MODE=true

# --- S3 (Silo locally) -------------------------------------------------------
# Silo is an S3-compatible server (a maintained fork of open-source MinIO).
# These keys are BOTH its root credentials and the app's S3 credentials, so
# they're stated once - compose feeds them to Silo as MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD. Silo enforces a minimum length and refuses to start
# otherwise: key >= 3 chars, secret >= 8 chars.
# In prod: unset S3_ENDPOINT_URL and both AWS keys entirely, and let the task's
# IAM role supply credentials. Also set S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB="postgres"
POSTGRES_USER="crane_admin"
POSTGRES_PASSWORD="ch@ngeMe!"

# The SAME password, percent-encoded for use inside a URL. The database URLs
# below (and the ones compose builds) are URLs, so a password containing @ : /
# ? # [ ] or % must be encoded or it silently breaks parsing - a bare @ ends the
# userinfo early. Encode: @ -> %40, : -> %3A, / -> %2F, ? -> %3F, # -> %23,
# [ -> %5B, ] -> %5D, % -> %25. ! ~ * ' ( ) and - . _ need no encoding.
#   ch@ngeMe!  ->  ch%40ngeMe!
# Keep this in sync with POSTGRES_PASSWORD above.
POSTGRES_PASSWORD_URLENC="ch%40ngeMe!"

# Host-side database URLs (used by run-local.sh and migrate.sh). TWO databases
# on the same server, named the way the pg-role-provisioning skill provisions
# them (<app>, <app>_dbos):
#   orders_api       the application DB, holding our own tables
#   orders_api_dbos  the DBOS system DB, SHARED by the worker and the consumer -
#                    they are one DBOS app running as two processes
# Both are created by backing/init-db.sql. Rename to match your provisioning if
# you are not using the bundled Postgres.
#
# NOTE: orders_api_dbos is shorter than the system-database name DBOS derives
# from the app database on its own, which is why it is set explicitly here and
# in compose rather than left to a default.
APP_DATABASE_URL=postgresql://crane_admin:ch%40ngeMe!@localhost:5432/orders_api
DBOS_DATABASE_URL=postgresql://crane_admin:ch%40ngeMe!@localhost:5432/orders_api_dbos

# --- Redpanda ----------------------------------------------------------------
# On the host use the EXTERNAL listener (19092); containers use redpanda:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- OpenTelemetry -----------------------------------------------------------
# Aspire Dashboard OTLP ingest (UI at http://localhost:18888).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18889

# --- Email (SMTP) ------------------------------------------------------------
# Mailpit locally (no auth/TLS; web UI at http://localhost:8025). For SES/prod,
# point at the SES SMTP endpoint and set SMTP_USERNAME/SMTP_PASSWORD/
# SMTP_USE_TLS=true.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=orders@example.com

# --- Downstream REST API (consumer) ------------------------------------------
# The external API the consumer's workflow notifies after projecting an event.
# Leave unset and that step logs and returns - this stack has no such service.
# EXTERNAL_API_TIMEOUT defaults to 10 seconds.
# EXTERNAL_API_URL=https://example.internal/api
# EXTERNAL_API_TOKEN=
# EXTERNAL_API_TIMEOUT=10

# --- Azure AD auth -----------------------------------------------------------
# Real Azure AD auth (also set DEV_MODE=false): uncomment and fill in.
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
