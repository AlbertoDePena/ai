# Local dev stack for ${APP_NAME}. Copy to .env and adjust.
#
# Every host port lives here so this repo's stack can run alongside another
# repo's. Pick one PORT_BASE lane per repo and keep the offsets:
#   repo A (default):  base 0      -> 5432, 9000, 9001, 8025, 1025, 19092, 8080, 3000, 4317, 4318
#   repo B:            base +100   -> 5532, 9100, 9101, 8125, 1125, 19192, 8180, 3100, 4417, 4418
#   repo C:            base +200   -> 5632, 9200, 9201, 8225, 1225, 19292, 8280, 3200, 4517, 4518

# Prefixes every container name and namespaces the Docker volumes.
APP_NAME=${APP_NAME}
COMPOSE_PROJECT_NAME=${APP_NAME}

# postgres
POSTGRES_DB="${APP_NAME}"
POSTGRES_USER="crane_admin"
POSTGRES_PASSWORD="P@55word!"
POSTGRES_PORT=5432

# s3 (silo — keeps MinIO's variable names; user >= 3 chars, password >= 8)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
S3_BUCKET="${APP_NAME}"
S3_PORT=9000
S3_CONSOLE_PORT=9001

# mailpit
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# redpanda (kafka)
KAFKA_PORT=19092
KAFKA_CONSOLE_PORT=8080

# otel-lgtm (grafana + loki + tempo + prometheus + pyroscope)
# 3000 is a popular port — if something else on this machine already serves it
# (another Grafana, a Node/Vite dev server), take the next lane rather than
# moving this one variable out of step with the rest.
OTEL_UI_PORT=3000
OTEL_OTLP_GRPC_PORT=4317
OTEL_OTLP_HTTP_PORT=4318
