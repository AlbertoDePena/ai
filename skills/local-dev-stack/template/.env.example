# The shared local dev stack. Copy to .env next to docker-compose.yml.
#
# Host ports are fixed in docker-compose.yml, not here — only one copy of this
# stack ever runs, so there is nothing to shift onto another lane. These are
# the root credentials for the two services that need them.

# s3 (silo — keeps MinIO's variable names; user >= 3 chars, password >= 8)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# postgres — the superuser. Applications get their own databases and login
# roles under it (see the pg-role-provisioning skill).
POSTGRES_USER="crane_admin"
POSTGRES_PASSWORD="P@55word!"
